{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://localhost:*" }, { "url": "http://127.0.0.1:*" }, { "url": "https://lrclib.net/*" }, { "url": "https://musicbrainz.org/*" }]
    }
  ]
}
